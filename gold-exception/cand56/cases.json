{
  "cases": [
    {
      "name": "base_permission_no_escape_opening",
      "facts": [
        "fire_doorset(d1).",
        "fusible_link(d1)."
      ],
      "expect": {
        "applies": true,
        "violation": false
      }
    },
    {
      "name": "prohibited_on_escape_opening",
      "facts": [
        "fire_doorset(d1).",
        "fusible_link(d1).",
        "escape_opening(d1)."
      ],
      "expect": {
        "applies": true,
        "violation": true
      }
    },
    {
      "name": "counter_exception_c7",
      "facts": [
        "fire_doorset(d1).",
        "fusible_link(d1).",
