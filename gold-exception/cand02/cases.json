      ],
      "expect": {
        "applies": true,
        "violation": false
      }
    },
    {
      "name": "exception_demonstrated_smaller",
      "facts": [
        "replacement_generation_system(n1, o1).",
        "capacity(n1, 3).",
        "capacity(o1, 4).",
        "demonstrated_more_appropriate(n1)."
      ],
      "expect": {
        "applies": true,
        "violation": false
      }
    },
    {
      "name": "almost_met_claimed_not_demonstrated",
      "facts": [
