        "free_height(e1, 2200)."
      ],
      "expect": {
        "applies": true,
        "violation": false
      }
    },
    {
      "name": "exception_area_protected",
      "facts": [
        "protruding_element(e1).",
        "free_height(e1, 2000).",
        "area_protected(e1)."
      ],
      "expect": {
        "applies": true,
        "violation": false
      }
    },
    {
      "name": "not_applicable",
      "facts": [
        "flush_facade_element(e1)."
      ],
      "expect": {
        "applies": false,
        "violation": false
      }
    },
    {
      "name": "distractor_two_elements",
      "facts": [
        "protruding_element(e1).",
