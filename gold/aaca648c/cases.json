{
  "cases": [
    {
      "name": "clear_compliant",
      "facts": [
        "lifting_platform(p1).",
        "reflective_surfaces_minimised(p1)."
      ],
      "expect": {
        "applies": true,
        "violation": false
      }
    },
    {
      "name": "clear_violation",
      "facts": [
        "lifting_platform(p1)."
      ],
      "expect": {
        "applies": true,
        "violation": true
      }
    },
    {
      "name": "not_applicable",
      "facts": [
        "lift_lobby(l1)."
      ],
      "expect": {
        "applies": false,
        "violation": false
      }
    },
    {
      "name": "distractor",
      "facts": [
        "lifting_platform(p1).",
        "reflective_surfaces_minimised(p1).",
        "mirror(m1)."
      ],
      "expect": {
        "applies": true,
        "violation": false
      }
    }
  ]
}
