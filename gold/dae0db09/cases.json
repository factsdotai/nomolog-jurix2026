      ],
      "expect": {
        "applies": true,
        "violation": false
      }
    },
    {
      "name": "not_applicable",
      "facts": [
        "masonry_wall(m1)."
      ],
      "expect": {
        "applies": false,
        "violation": false
      }
    },
    {
      "name": "distractor",
      "facts": [
        "light_permeable_structure(g1).",
        "withstands_normal_load(g1).",
        "light_permeable_structure(g2).",
        "protected_by_collision_barrier(g2)."
      ],
      "expect": {
        "applies": true,
        "violation": false
      }
